{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "A REST API for tracking personal expenses, built with **Node.js**, **Express**, **PostgreSQL** (via Sequelize), and **JWT authentication**.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "tsc",
    "migrate": "node scripts/migrate.js",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigoftw/expense-tracker.git"
  },
  "keywords": [],
  "author": "Rodrigo Andrade",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rodrigoftw/expense-tracker/issues"
  },
  "homepage": "https://github.com/rodrigoftw/expense-tracker#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-validator": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "clearMocks": true
  },
  "directories": {
    "test": "tests"
  }
}
