{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "A REST API for tracking personal expenses, built with **Node.js**, **Express**, **PostgreSQL** (via Sequelize), and **JWT authentication**.",
  "main": "server.ts",
  "scripts": {
    "start": "node server.ts",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "migrate": "node scripts/migrate.ts",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigoftw/expense-tracker.git"
  },
  "keywords": [],
  "author": "Rodrigo Andrade",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rodrigoftw/expense-tracker/issues"
  },
  "homepage": "https://github.com/rodrigoftw/expense-tracker#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.18",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/backend/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "clearMocks": true
  },
  "directories": {
    "test": "tests"
  }
}
